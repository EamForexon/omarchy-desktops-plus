#!/usr/bin/env bash
set -euo pipefail

if (($# != 2)) || [[ ! $1 =~ ^[0-9]+$ ]] || [[ ! $2 =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "Usage: output-set-default <node-id> <sink-name>" >&2
  exit 2
fi

node_id=$1
sink_name=$2

# Switching the default output moves every playing stream to it, except these
# apps (by application.name, lowercase), which stay on the output they're on:
# e.g. a voice chat kept on the headset while music follows the new default.
keep_apps='["vesktop", "discord"]'

sink_inputs=$(pactl -f json list sink-inputs)
sinks=$(pactl -f json list sinks)
mapfile -t kept_routes < <(
  jq -nr --argjson inputs "$sink_inputs" --argjson sinks "$sinks" --argjson keep "$keep_apps" '
    $inputs[]
    | . as $input
    | select(($input.properties["application.name"] // "") | ascii_downcase | IN($keep[]))
    | $sinks[]
    | select(.index == $input.sink)
    | "\($input.index)\t\(.name)"
  '
)

timeout 2 wpctl set-default "$node_id"
timeout 2 pactl set-default-sink "$sink_name"

sink_inputs=$(pactl -f json list sink-inputs)
mapfile -t input_ids < <(
  jq -r --argjson keep "$keep_apps" '
    .[]
    | select(.properties["application.name"] != null)
    | select(.properties["application.name"] | ascii_downcase | IN($keep[]) | not)
    | .index
  ' <<<"$sink_inputs"
)

for input_id in "${input_ids[@]}"; do
  if ! timeout 2 pactl move-sink-input "$input_id" "$sink_name"; then
    echo "Could not move audio stream $input_id to $sink_name" >&2
  fi
done

sleep 0.25
for route in "${kept_routes[@]}"; do
  IFS=$'\t' read -r input_id target_sink <<<"$route"
  if ! timeout 2 pactl move-sink-input "$input_id" "$target_sink"; then
    echo "Could not keep stream $input_id on $target_sink" >&2
  fi
done
